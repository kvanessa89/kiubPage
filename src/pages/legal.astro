---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { SITE } from '../lib/blog';

const title = 'Datos legales | kiub';
const description = 'Datos legales de kiub: razón social, cédula jurídica, marca registrada, domicilio en Escazú, Costa Rica, y canales de contacto.';
const canonical = `${SITE}/legal/`;

const legal: [string, string][] = [
  ['Nombre comercial', 'kiub'],
  ['Razón social', '3-101-854183 SOCIEDAD ANONIMA'],
  ['Cédula jurídica', '3-101-854183'],
  ['Actividad', 'Consultores informáticos'],
  ['Año de fundación', '2022'],
  ['Domicilio', 'San Rafael de Escazú, San José, Costa Rica, 10203'],
  ['Marca', 'KIUB® — marca de servicios en clase 42 (diseño y desarrollo de software), inscrita el 13 de marzo de 2023 en el Registro de la Propiedad Intelectual de Costa Rica a nombre de 3-101-854183 S.A. (expediente n.º 2022-0009622)'],
];

const profiles: [string, string][] = [
  ['LinkedIn', 'https://www.linkedin.com/company/kiub-co/'],
  ['Instagram', 'https://www.instagram.com/kiub.co'],
  ['Facebook', 'https://www.facebook.com/kiub.co.cr'],
  ['Clutch', 'https://clutch.co/profile/kiub'],
  ['GoodFirms', 'https://www.goodfirms.co/company/kiub'],
];
---
<Base title={title} description={description} canonical={canonical} alternates={false}>
  <Nav />
  <main>
    <header class="phead">
      <div class="hero-grid-bg"></div>
      <div class="glow g2" style="top:-180px"></div>
      <div class="wrap" style="position:relative;z-index:2">
        <span class="eyebrow center">Empresa</span>
        <h1 class="h-lg" style="margin-top:20px;font-weight:400">Datos legales</h1>
      </div>
    </header>

    <section class="section" style="padding-top:24px;padding-bottom:72px">
      <div class="wrap">
        <article class="doc">
          <h2>Quiénes somos</h2>
          <p>kiub es una empresa costarricense de tecnología y consultoría de software, fundada en 2022 y ubicada en San Rafael de Escazú. Diseñamos software a la medida, automatizamos procesos y creamos páginas web enfocadas en las necesidades reales de cada negocio.</p>
          <p>Trabajamos con empresas que quieren ordenar su operación con herramientas propias: sistemas internos, plataformas de gestión, facturación y cobros, CRM y sitios web. Algunos de los equipos que ya construyen con kiub son Autocrash Solutions, OviqCR y Grupo Jurídico.</p>

          <h2>Datos legales</h2>
          <div class="doc-table">
            <table class="kv">
              {legal.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </table>
          </div>

          <h2>Fundadora</h2>
          <p><strong>Carol Hernández</strong> — Founder &amp; CEO.<br />Carol fundó kiub en 2022 y cuenta con 14 años de experiencia construyendo software.</p>

          <h2>Dirección</h2>
          <p>San Rafael de Escazú, San José, Costa Rica, 10203</p>

          <h2>Contacto</h2>
          <ul>
            <li><strong>Correo:</strong> <a href="mailto:info@kiub.co">info@kiub.co</a></li>
            <li><strong>Teléfono / WhatsApp:</strong> <a href="https://wa.me/50664511884" target="_blank" rel="noopener noreferrer">+506 6451 1884</a></li>
            <li><strong>EE. UU. / WhatsApp:</strong> <a href="https://wa.me/17866039420" target="_blank" rel="noopener noreferrer">+1 (786) 603-9420</a></li>
            <li><strong>Horario:</strong> lunes a viernes de 8:00 a 17:00, sábados de 8:00 a 12:00</li>
          </ul>

          <h2>Redes y perfiles</h2>
          <ul>
            {profiles.map(([label, href]) => (
              <li><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
            ))}
          </ul>

          <h2>Más información</h2>
          <ul>
            <li><a href="/contacto/">Contacto</a></li>
            <li><a href="/servicios/">Servicios</a></li>
          </ul>
        </article>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
