---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Proceso from '../components/sections/Proceso.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { content } from '../data/content';

const t = content.es;
const sp = t.servicesPage;
---
<Base title="kiub">
  <Nav />
  <main>
    <header class="phead">
      <div class="hero-grid-bg"></div>
      <div class="glow g2" style="top:-180px"></div>
      <div class="wrap" style="position:relative;z-index:2">
        <span class="eyebrow center">{sp.eyebrow}</span>
        <div class="h-lg" style="margin-top:20px">{sp.title}</div>
        <p class="lead" style="margin:20px auto 0;max-width:600px">{sp.sub}</p>
      </div>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="wrap">
        <div class="svc-grid">
          {t.services.items.map((item) => (
            <div class="reveal">
              <div class="card svc" style={`--c:${item.color};padding:36px 32px 34px`}>
                <div class="svc-ico" style={`color:${item.color}`}>
                  <Icon name={item.icon} size={26} />
                </div>
                <h3 style="font-size:23px">{item.name}</h3>
                <p>{item.desc}</p>
                <ul class="svc-list">
                  {item.points.map((pt) => (
                    <li>
                      <Icon name="check" size={17} sw={2.4} />
                      {pt}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Proceso process={t.process} colored bg />
    <CtaBand ctaBand={t.ctaBand} />
  </main>
  <Footer />

  <a class="wa-fab" href="https://wa.me/50660234113" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23a8.2 8.2 0 0 1 5.82 2.41 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.69 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/>
    </svg>
  </a>
</Base>
