---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { useI18n, routes, getPage } from '../i18n';
interface Props {
  title?: string;
  description?: string;
}
const { lang, t } = useI18n(Astro.url);
const page = getPage(Astro.url);
const {
  title = 'kiub',
  description = t.meta.home.description,
} = Astro.props;
const abs = (path: string) => new URL(path, 'https://kiub.co').href;
const canonical = abs(routes[lang][page]);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'kiub',
  url: 'https://kiub.co/',
  logo: 'https://kiub.co/assets/kiub-logo.png',
  image: 'https://kiub.co/og-image.png',
  description: t.meta.home.description,
  founder: { '@type': 'Person', name: 'Carol Hernández' },
  foundingDate: '2022',
  email: 'info@kiub.co',
  telephone: '+506 6451 1884',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Escazú',
    addressRegion: 'San José',
    addressCountry: 'CR',
  },
  sameAs: [
    'https://www.linkedin.com/company/kiub-co/',
    'https://www.facebook.com/kiub.co.cr',
    'https://www.instagram.com/kiub.info.cr',
    'https://clutch.co/profile/kiub',
    'https://www.goodfirms.co/company/kiub',
    'https://www.sortlist.com/agency/kiub',
    'https://www.agencyspotter.com/kiub',
  ],
};
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />

    <!-- SEO -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={abs(routes.es[page])} />
    <link rel="alternate" hreflang="en" href={abs(routes.en[page])} />
    <link rel="alternate" hreflang="x-default" href={abs(routes.es[page])} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kiub" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_CR'} />
    <meta property="og:image" content="https://kiub.co/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ui.ogAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kiub.co/og-image.png" />
    <meta name="twitter:image:alt" content={t.ui.ogAlt} />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z07B2NL0HM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Z07B2NL0HM');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
