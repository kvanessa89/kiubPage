---
import { content } from '../data/content';
const nav = content.es.nav;
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<nav class="nav" style="background:var(--bg-soft);border-bottom-color:var(--line)">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="kiub inicio">
      <span style="height:30px;display:inline-flex">
        <img class="kiub-logo logo-on-dark" src="/assets/kiub-logo.png" alt="kiub" height="30" />
        <img class="kiub-logo logo-on-light" src="/assets/kiub-logo-dark.png" alt="kiub" height="30" />
      </span>
    </a>

    <div class="nav-links">
      <a href="/" class={`nav-link${isActive('/') ? ' active' : ''}`}>{nav.home}</a>
      <a href="/servicios" class={`nav-link${isActive('/servicios') ? ' active' : ''}`}>{nav.services}</a>
      <a href="/contacto" class={`nav-link${isActive('/contacto') ? ' active' : ''}`}>{nav.contact}</a>
    </div>

    <div class="nav-right">
      <div class="nav-socials">
        <a href="https://www.linkedin.com/company/kiub-co/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="24" height="24" rx="5" fill="#0A66C2"/>
            <path fill="#fff" d="M7.15 9.85h2.4V17h-2.4V9.85zM8.35 6.4a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8zM11.1 9.85h2.3v.98h.03c.32-.6 1.1-1.23 2.27-1.23 2.43 0 2.88 1.6 2.88 3.68V17h-2.4v-3.3c0-.79-.02-1.8-1.1-1.8-1.1 0-1.27.86-1.27 1.75V17h-2.4V9.85z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/kiub.co.cr" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="24" height="24" rx="5" fill="#1877F2"/>
            <path fill="#fff" d="M15.4 8.6h1.4V6.2c-.24-.03-1.07-.1-2.03-.1-2.02 0-3.4 1.24-3.4 3.5v2.05H9.3v2.7h2.07V19h2.72v-6.65h2.06l.33-2.7h-2.39V9.9c0-.78.21-1.3 1.31-1.3z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/kiub.info.cr" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <radialGradient id="ig-nav" cx="0.3" cy="1.05" r="1.2">
                <stop offset="0" stop-color="#FFDD55"/>
                <stop offset="0.35" stop-color="#FF543E"/>
                <stop offset="0.65" stop-color="#C837AB"/>
                <stop offset="1" stop-color="#5A5FE6"/>
              </radialGradient>
            </defs>
            <rect width="24" height="24" rx="6" fill="url(#ig-nav)"/>
            <rect x="6.3" y="6.3" width="11.4" height="11.4" rx="3.6" fill="none" stroke="#fff" stroke-width="1.5"/>
            <circle cx="12" cy="12" r="3.2" fill="none" stroke="#fff" stroke-width="1.5"/>
            <circle cx="16.1" cy="7.9" r="0.9" fill="#fff"/>
          </svg>
        </a>
      </div>

      <button class="nav-burger" id="nav-burger" aria-label="Abrir menú" aria-expanded="false">
        <svg id="burger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<div class="mmenu" id="mmenu">
  <a href="/" class={isActive('/') ? 'active' : ''}>{nav.home}</a>
  <a href="/servicios" class={isActive('/servicios') ? 'active' : ''}>{nav.services}</a>
  <a href="/contacto" class={isActive('/contacto') ? 'active' : ''}>{nav.contact}</a>
</div>

<script>
  function initNav() {
    const burger = document.getElementById('nav-burger')!;
    const menu = document.getElementById('mmenu')!;
    const burgerIcon = document.getElementById('burger-icon')!;
    const closeIcon = document.getElementById('close-icon')!;

    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      burgerIcon.style.display = open ? 'none' : '';
      closeIcon.style.display = open ? '' : 'none';
    });

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.style.transition = 'none';
        menu.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        burgerIcon.style.display = '';
        closeIcon.style.display = 'none';
        requestAnimationFrame(() => { menu.style.transition = ''; });
      });
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
