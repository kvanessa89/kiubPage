---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  /** Solo la portada del post y la del destacado se cargan con prioridad. */
  priority?: boolean;
}
const { src, alt, sizes, priority = false } = Astro.props;
---
<div class="cover has-img">
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    format="webp"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <span class="cv-bar" aria-hidden="true"></span>
</div>
