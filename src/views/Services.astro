---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Icon from '../components/Icon.astro';
import Proceso from '../components/sections/Proceso.astro';
import FindUs from '../components/sections/FindUs.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro.url);
const sp = t.servicesPage;
---
<Base title={t.meta.services.title} description={t.meta.services.description}>
  <Nav />
  <main>
    <header class="phead">
      <div class="hero-grid-bg"></div>
      <div class="glow g2" style="top:-180px"></div>
      <div class="wrap" style="position:relative;z-index:2">
        <span class="eyebrow center">{sp.eyebrow}</span>
        <h1 class="h-lg" style="margin-top:20px;font-weight:400">{sp.title}</h1>
        <p class="lead" style="margin:20px auto 0;max-width:600px">{sp.sub}</p>
      </div>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="wrap">
        <div class="svc-grid">
          {t.services.items.map((item) => (
            <div class="reveal">
              <div class="card svc" style={`--c:${item.color};padding:36px 32px 34px`}>
                <div class="svc-ico" style={`color:${item.color}`}>
                  <Icon name={item.icon} size={26} />
                </div>
                <h2 style="font-size:23px">{item.name}</h2>
                <p>{item.desc}</p>
                <ul class="svc-list">
                  {item.points.map((pt) => (
                    <li>
                      <Icon name="check" size={17} sw={2.4} />
                      {pt}
                    </li>
                  ))}
                </ul>
                {item.guide && (
                  <a class="svc-guide" href={item.guide[1]}>{item.guide[0]}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Proceso process={t.process} colored bg />
    <FindUs findUs={t.findUs} />
    <CtaBand ctaBand={t.ctaBand} />
  </main>
  <Footer />

  <WhatsAppFab />
</Base>
