---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Hero from '../components/sections/Hero.astro';
import Trust from '../components/sections/Trust.astro';
import About from '../components/sections/About.astro';
import ServicesTeaser from '../components/sections/ServicesTeaser.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FindUs from '../components/sections/FindUs.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro.url);
---
<Base title={t.meta.home.title} description={t.meta.home.description}>
  <Nav />
  <main>
    <Hero hero={t.hero} />
    <Trust trust={t.trust} />
    <About about={t.about} />
    <ServicesTeaser services={t.services} />
    <Testimonials testimonials={t.testimonials} />
    <FindUs findUs={t.findUs} />
    <CtaBand ctaBand={t.ctaBand} />
  </main>
  <Footer />

  <WhatsAppFab />
</Base>
