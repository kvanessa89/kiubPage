---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Icon from '../components/Icon.astro';
import Heading from '../components/Heading.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro.url);
const c = t.contactPage;

const infoColors: Record<string, string> = {
  mail: 'var(--green)',
  phone: 'var(--orange)',
  wa: '#25d366',
  pin: 'var(--blue)',
  clock: 'var(--text-dim)',
};
---
<style>
  @media (max-width: 600px) {
    .cinfo-grid { grid-template-columns: 1fr !important; }
  }
</style>
<Base title={t.meta.contact.title} description={t.meta.contact.description}>
  <Nav />
  <main>
    <header class="phead">
      <div class="hero-grid-bg"></div>
      <div class="glow g3" style="top:-120px;bottom:auto"></div>
      <div class="wrap" style="position:relative;z-index:2">
        <span class="eyebrow center">{c.eyebrow}</span>
        <h1 class="h-lg" style="margin-top:20px;font-weight:400">{c.title}</h1>
        <p class="lead" style="margin:20px auto 0;max-width:600px">{c.sub}</p>
      </div>
    </header>

    <section class="section" style="padding-top:16px">
      <div class="wrap">
        {[c.info.slice(0, 3), c.info.slice(3)].map((row, ri) => (
          <div
            class="cinfo-grid"
            style={`grid-template-columns:repeat(${row.length},1fr)${ri > 0 ? ';margin-top:18px' : ''}`}
          >
            {row.map((item) => {
              const color = infoColors[item.k] ?? 'var(--text-dim)';
              const inner = (
                <>
                  <span class="ci" style={`color:${color}`}>
                    <Icon name={item.k} size={20} />
                  </span>
                  <div>
                    <div class="lbl">{item.lbl}</div>
                    <div class="val">{item.val}</div>
                  </div>
                </>
              );
              return item.href
                ? <a class="card cinfo-item cinfo-link reveal" href={item.href} {...(item.href.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}>{inner}</a>
                : <div class="card cinfo-item reveal">{inner}</div>;
            })}
          </div>
        ))}

      </div>
    </section>

    <section class="section tight faq-section" style="background:var(--bg-soft);border-top:1px solid var(--line)">
      <div class="wrap">
        <Heading center eyebrow="FAQ" title={c.faqTitle} />
        <FaqAccordion items={c.faq} />
      </div>
    </section>
  </main>
  <Footer />

  <WhatsAppFab />
</Base>
