<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración para el hosting (IIS). Se copia a la raíz de dist/ en cada build.
  IIS responde 404 a las extensiones que no conoce: aquí se registran las que usa
  el sitio (portadas del blog en .webp/.avif). El <remove> evita un error 500 si
  el servidor ya tuviera la extensión registrada.
  Las reglas de <rewrite> reemplazan al antiguo .htaccess y requieren el módulo
  URL Rewrite de IIS.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- www.kiub.co → https://kiub.co (evita contenido duplicado) -->
        <rule name="www a dominio raíz" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.kiub\.co$" />
          </conditions>
          <action type="Redirect" url="https://kiub.co/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- http → https (solo para kiub.co, no para la URL temporal del hosting) -->
        <rule name="http a https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^kiub\.co$" />
          </conditions>
          <action type="Redirect" url="https://kiub.co/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Páginas eliminadas a propósito: 410 Gone -->
        <rule name="Páginas eliminadas" stopProcessing="true">
          <match url="^(test|newsletter)/?$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Esta página fue eliminada." />
        </rule>
        <!-- Antigua versión en español indexada por Google -->
        <rule name="es a home" stopProcessing="true">
          <match url="^es/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="sitemap.xml a sitemap-index.xml" stopProcessing="true">
          <match url="^sitemap\.xml$" />
          <action type="Redirect" url="/sitemap-index.xml" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
