<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración para el hosting (IIS). Se copia a la raíz de dist/ en cada build.
  IIS responde 404 a las extensiones que no conoce: aquí se registran las que usa
  el sitio (portadas del blog en .webp/.avif). El <remove> evita un error 500 si
  el servidor ya tuviera la extensión registrada.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
  </system.webServer>
</configuration>
