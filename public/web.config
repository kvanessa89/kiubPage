<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración para el hosting (IIS). Se copia a la raíz de dist/ en cada build.
  IIS responde 404 a las extensiones que no conoce: aquí se registran las que usa
  el sitio (portadas del blog en .webp/.avif). El <remove> evita un error 500 si
  el servidor ya tuviera la extensión registrada.
  Las reglas de <rewrite> reemplazan al antiguo .htaccess y requieren el módulo
  URL Rewrite de IIS.

  Caché: por defecto el hosting manda max-age de 1 año a todo. Aquí el HTML y los
  archivos sin hash (assets/, logos/, favicons) se revalidan en cada visita (no-cache
  usa el ETag, así que si no cambió el servidor responde 304 sin reenviar el archivo).
  Solo _astro/, cuyos nombres llevan hash y cambian en cada build, se guarda 1 año.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <!-- 404 propia (dist/404.html) en lugar de la genérica de IIS; conserva el código 404 -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite>
      <rules>
        <!-- www.kiub.co → https://kiub.co (evita contenido duplicado) -->
        <rule name="www a dominio raíz" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.kiub\.co$" />
          </conditions>
          <action type="Redirect" url="https://kiub.co/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- http → https (solo para kiub.co, no para la URL temporal del hosting) -->
        <rule name="http a https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^kiub\.co$" />
          </conditions>
          <action type="Redirect" url="https://kiub.co/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Páginas eliminadas a propósito: 410 Gone -->
        <rule name="Páginas eliminadas" stopProcessing="true">
          <match url="^(test|newsletter)/?$" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Esta página fue eliminada." />
        </rule>
        <!-- Antigua versión en español indexada por Google -->
        <rule name="es a home" stopProcessing="true">
          <match url="^es/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="sitemap.xml a sitemap-index.xml" stopProcessing="true">
          <match url="^sitemap\.xml$" />
          <action type="Redirect" url="/sitemap-index.xml" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <!-- Archivos con hash en el nombre: se pueden guardar 1 año sin riesgo -->
  <location path="_astro">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
